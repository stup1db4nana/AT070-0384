  <dashboards>
    <dashboard name='스토리 1' type='storyboard'>
      <style />
      <size maxheight='964' maxwidth='1016' minheight='964' minwidth='1016' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98340' id='1' param='vert' removable='false' type-v2='layout-flow' w='98426' x='787' y='830'>
            <zone h='3423' id='3' type-v2='title' w='98426' x='787' y='830' />
            <zone h='10477' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='98426' x='787' y='4253' />
            <zone h='84440' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='98426' x='787' y='14730'>
              <flipboard active-id='6' nav-type='caption' show-nav-arrows='true'>
                <story-points>
                  <story-point caption='2014년 창업 3,493개 → 2025년 1,919개로 감소. 폐업률은 2014년 79%에서 최근 창업 카페는 아직 데이터 축적 중이나 역사적으로 66% 수준. 매년 창업 카페 10개 중 7개는 5년 안에 폐업.' captured-sheet='01_창업폐업추이' id='1' />
                  <story-point caption=': 20~44세 소비인구 2014년 421만 → 2025년 357만으로 -15.2% 감소. 카페 1개당 소비인구는 1,205명 → 1,861명으로 증가 — 공급과잉이 아니라 시장 자체가 줄어드는 구조적 문제.' captured-sheet='02_소비인구추이' id='2' />
                  <story-point caption='중구 458개/만명, 종로구 352개, 마포구 295개 순으로 포화. 마포구 폐업률 77.2%로 최고 — 카페 밀도가 높을수록 폐업률이 높아지는 패' captured-sheet='03_카페밀도와 폐업률의 관계' id='3' />
                  <story-point caption='강북(24.7%)·도봉(24.3%) 고령화 최고지만 폐업률은 중간 수준. 마포(고령화 16.1%)가 폐업률 77.2% 최고 — 고령화보다 카페 경쟁밀도가 폐업의 실질 원인.' captured-sheet='04_고령화산점도' id='4' />
                  <story-point caption='저임대+경쟁보통+대형 조합 5년이상 생존율 72.6% (1위). 소형카페는 어떤 조건에서도 대형 대비 생존율 10~15%p 낮음. 규모의 경제가 카페 생존에도 적용.' captured-sheet='05_요인분석' id='5'>
                    <capturedDeltas>
                      <worksheet name='05_요인분석'>
                        <filter class='categorical' column='[federated.1ek1z6r0axxufa13k3qaz18koi7p].[none:규모구분:nk]'>
                          <groupfilter function='level-members' level='[none:규모구분:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
                        </filter>
                      </worksheet>
                    </capturedDeltas>
                  </story-point>
                  <story-point caption='① 저임대+경쟁보통+대형 → 72.6% (A) ② 중임대+경쟁보통+대형 → 70.1% (A) ③ 소형카페는 어떤 조건에서도 대형 대비 생존율 낮음. 창업지는 노원·관악·송파(소비인구 많고 밀도 낮음) 우선 고려.' captured-sheet='06_황금조합' id='6' />
                </story-points>
              </flipboard>
            </zone>
          </zone>
